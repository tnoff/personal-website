{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>tnoff/github-workflows//renovate/default-github"],
  "enabledManagers": ["github-actions", "dockerfile", "pre-commit", "custom.regex"],
  "packageRules": [
    {
      "matchPackageNames": ["pytest", "pytest-cov", "pytest-mock", "requests-mock", "tox", "pylint", "bandit"],
      "additionalBranchPrefix": "test-",
      "automerge": true
    },
    {
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["!pytest", "!pytest-cov", "!pytest-mock", "!requests-mock", "!tox", "!pylint", "!bandit"],
      "additionalBranchPrefix": "dev-"
    }
  ]
}
